MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=spark
MYSQL_PASSWORD=
MYSQL_DATABASE=spark_db

# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Comma-separated list of origins allowed to call the API cross-origin.
# Leave empty for local development and when the site and /api share an origin (nginx.conf).
# Example: https://sparkcurv.com,https://www.sparkcurv.com
CORS_ORIGINS=

# Set to false only for local development over plain http on a non-localhost host.
COOKIE_SECURE=true

# Used once, to create the first admin when the users table has no admin yet.
# Existing passwords are never overwritten. Remove after the first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=

SMTP_EMAIL=
SMTP_PASSWORD=
NOTIFY_EMAIL=
