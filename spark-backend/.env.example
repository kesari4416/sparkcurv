MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=spark
MYSQL_PASSWORD=
MYSQL_DATABASE=spark_db

# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Comma-separated list of origins allowed to call the API cross-origin.
# Leave empty for local development and when the site and /api share an origin (nginx.conf).
# Example: https://sparkcurv.com,https://www.sparkcurv.com
CORS_ORIGINS=

# Set to false only for local development over plain http on a non-localhost host.
COOKIE_SECURE=true

# Used once, to create the first admin when the users table has no admin yet.
# Existing passwords are never overwritten. Remove after the first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Enquiry emails (the contact form and the home-page email box). Leave SMTP_USER, SMTP_PASSWORD
# and CONTACT_TO empty and the enquiry is still saved, just not emailed.
# Port 465 = SSL, any other port (587 is usual) = STARTTLS. Gmail needs an app password.
# Check the setup with: python smtp_check.py --send
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Sent from this address; blank = SMTP_USER. "SparkCurv <sales@sparkcurv.com>" also works.
SMTP_FROM=
# Where enquiries are delivered.
CONTACT_TO=
# The older names SMTP_EMAIL (= SMTP_USER) and NOTIFY_EMAIL (= CONTACT_TO) still work.
