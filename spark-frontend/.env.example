# Leave empty: the browser calls /api on the same origin, which Next.js (next.config.ts)
# or nginx forwards to the backend. Only set this if the API is on another host.
NEXT_PUBLIC_BACKEND_URL=

# Where Next.js forwards /api requests (used by `yarn dev` and `yarn start`).
BACKEND_ORIGIN=http://127.0.0.1:8001
